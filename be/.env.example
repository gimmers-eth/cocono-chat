# Server
PORT=3000
HOST=127.0.0.1

# Data stores
MONGO_URL=mongodb://127.0.0.1:27017/cocono-chat
REDIS_URL=redis://127.0.0.1:6379/0

# Auth — set a long random secret outside of local dev
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN_SEC=86400
NONCE_TTL_SEC=300

# Accounts
# Comma-separated list of usernames that cannot be registered
RESERVED_USERNAMES=server,admin,root,system,support
MAX_DEVICES=3

# Rate limiting (requests per window)
SIGNUP_IP_LIMIT=5
SIGNUP_IP_WINDOW_SEC=3600
CHALLENGE_IP_LIMIT=30
CHALLENGE_IP_WINDOW_SEC=900
VERIFY_ACCOUNT_LIMIT=20
VERIFY_ACCOUNT_WINDOW_SEC=900

# Internal admin app (pnpm admin) — binds localhost by default.
# If you expose it on a network, set ADMIN_TOKEN to a long random string.
ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1
ADMIN_TOKEN=
