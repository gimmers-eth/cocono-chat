# Server
PORT=3000
# Display name shown in the FE/admin (admin panel can override at runtime).
APP_NAME=co.co.no
# Default 0.0.0.0 (all interfaces) for LAN access; set 127.0.0.1 to lock down.
HOST=0.0.0.0
# Behind nginx: trust the proxy so request.ip is the real client IP for
# rate limiting. 'true', a hop count, or comma-separated trusted addresses.
TRUST_PROXY=

# Native TLS (recommended for LAN use — browsers require a secure context
# for WebCrypto/PWA on anything but localhost). Set BOTH to serve https/wss
# directly, no reverse proxy needed. Certs via acme.sh (DNS-01, EuroDNS):
#   ~/.acme.sh/acme.sh --issue --server letsencrypt --dns dns_eurodns \
#     -d dev.co.co.no --keylength ec-256
#   ~/.acme.sh/acme.sh --install-cert -d dev.co.co.no --ecc \
#     --key-file ~/certs/dev.co.co.no.key --fullchain-file ~/certs/dev.co.co.no.crt
# TLS_KEY_PATH=~/certs/dev.co.co.no.key
# TLS_CERT_PATH=~/certs/dev.co.co.no.crt

# Web Push (VAPID) — Phase 1 blind notifications; empty = push disabled.
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Push coalescing: one push per offline device per this window (the peek
# notification reports the rest as "+N more"), and how long a push service
# may hold an undelivered notification.
# Identity verification: unverified accounts may only message people who
# added them as a friend or messaged them first (COLD_SEND_REQUIRES_VERIFICATION
# =false disables the gate, e.g. for local development). ID photo cap:
# COLD_SEND_REQUIRES_VERIFICATION=true
# ID_DOC_MAX_BYTES=5242880
# ID_UPLOAD_REQUIRES_TRUSTED_VERIFIER=true
# CoCo social score: trusted needs score STRICTLY above threshold AND the
# account older than the min age (Sybil cool-down).
# COCO_TRUST_THRESHOLD=10
# COCO_TRUST_MIN_AGE_DAYS=30
# COCO_TRUST_MIN_VOUCHERS=2

# Profiles: bio length + tiny avatar cap (clients resize to 128px JPEG
# before upload; server re-validates). Avatars are mutual-add only.
# PROFILE_BIO_MAX_LEN=250
# PROFILE_AVATAR_MAX_BYTES=65536

# PUSH_COALESCE_SEC=90
# PUSH_TTL_SEC=21600

# Data stores
MONGO_URL=mongodb://127.0.0.1:27017/cocono-chat
REDIS_URL=redis://127.0.0.1:6379/0

# Auth — the server REFUSES TO BOOT with the dev default. Generate a secret:
#   openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
# Local-dev escape hatch for the boot check above (pnpm dev sets this itself).
ALLOW_DEV_JWT_SECRET=false
JWT_EXPIRES_IN_SEC=86400
NONCE_TTL_SEC=300
# Accepted clock skew for signed signup/enroll payloads (replay protection).
SIGNED_PAYLOAD_MAX_AGE_SEC=300

# Accounts
# Comma-separated list of usernames that cannot be registered
RESERVED_USERNAMES=server,admin,root,system,support
MAX_DEVICES=3

# Rate limiting (requests per window)
SIGNUP_IP_LIMIT=5
SIGNUP_IP_WINDOW_SEC=3600
CHALLENGE_IP_LIMIT=30
CHALLENGE_IP_WINDOW_SEC=900
VERIFY_ACCOUNT_LIMIT=20
VERIFY_ACCOUNT_WINDOW_SEC=900
VERIFY_IP_LIMIT=50
VERIFY_IP_WINDOW_SEC=900

# Device adding (milestone 2)
# Lifetime of the 6-digit pairing code
DEVICE_CODE_TTL_SEC=600
DEVICE_ENROLL_IP_LIMIT=10
DEVICE_ENROLL_IP_WINDOW_SEC=900
DEVICE_APPROVE_ACCOUNT_LIMIT=20
DEVICE_APPROVE_ACCOUNT_WINDOW_SEC=900
# Generous: enrolled devices poll the status endpoint every ~2s
ENROLL_STATUS_IP_LIMIT=600
ENROLL_STATUS_IP_WINDOW_SEC=900

# Self-service device detach (DELETE /api/devices/:id)
DEVICE_REMOVE_ACCOUNT_LIMIT=10
DEVICE_REMOVE_WINDOW_SEC=3600

# Messaging (milestone 3)
# Server-initiated WebSocket heartbeat interval
WS_HEARTBEAT_SEC=30
# How long pulled message copies are retained server-side for 'resync'
# re-delivery (seconds). Never-pulled copies stay queued regardless.
MSG_RETENTION_SEC=2592000
MSG_ACCOUNT_LIMIT=120
MSG_ACCOUNT_WINDOW_SEC=900
MSG_IP_LIMIT=240
MSG_IP_WINDOW_SEC=900
USER_KEYS_IP_LIMIT=60
USER_KEYS_IP_WINDOW_SEC=900

# 'Send diagnostics' uploads (client state reports stored in Mongo, TTL 30d)
DIAG_IP_LIMIT=30
DIAG_IP_WINDOW_SEC=3600
# Additional budget for reports sent while signed in (per account)
DIAG_ACCOUNT_LIMIT=10
DIAG_ACCOUNT_WINDOW_SEC=86400

# Internal admin app (pnpm admin). ADMIN_TOKEN is MANDATORY for a
# non-loopback ADMIN_HOST (the app refuses to boot without it) — and should
# be set regardless. Generate one the same way as JWT_SECRET.
ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1
ADMIN_TOKEN=
