{
  "name": "@cocono/be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/dev.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "admin": "node --env-file-if-exists=.env src/admin.js",
    "test": "LOG_LEVEL=silent node --env-file-if-exists=.env.test --test --test-concurrency=1 'test/*.test.js'"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "redis": "^6.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "ws": "^8.21.3"
  }
}
